{
  "expo": {
    "name": "Tarım Pusula",
    "slug": "tarim-pusula",
    "scheme": "tarimpusula",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-sqlite",
      "expo-notifications",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Tarlanın yerini bulmak için telefonunun konumuna bakacağız. Konumunu başka kimseyle paylaşmayız."
        }
      ],
      "@maplibre/maplibre-react-native",
      "expo-secure-store",
      "./plugins/with-cleartext",
      "expo-sharing",
      [
        "expo-calendar",
        {
          "calendarPermission": "Faaliyetleri telefon takvimine eklemek için takvim izni istenir. İzin vermezsen takvim dosyası (.ics) paylaşılır."
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Sesle soru sormak için mikrofon izni istenir. Ses kaydı saklanmaz.",
          "speechRecognitionPermission": "Sesini yazıya çevirmek için konuşma tanıma izni istenir.",
          "androidSpeechServicePackages": ["com.google.android.googlequicksearchbox"]
        }
      ],
      "expo-updates"
    ],
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./public/icon-192.png",
      "name": "Tarım Pusula",
      "shortName": "Tarım Pusula",
      "lang": "tr",
      "themeColor": "#064D3B",
      "backgroundColor": "#F1F3F4"
    },
    "experiments": {
      "typedRoutes": false
    },
    "icon": "./assets/icon.png",
    "ios": {
      "bundleIdentifier": "com.tarimpusula.app",
      "supportsTablet": false,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSPhotoLibraryUsageDescription": "Bitkinin fotoğrafını uzmana göstermek için galeriden seçeceksin. Fotoğraf başka amaçla kullanılmaz.",
        "NSCameraUsageDescription": "Bitkinin fotoğrafını uzmana göstermek için kamera kullanılır.",
        "NSMicrophoneUsageDescription": "Sesle soru sormak için mikrofon kullanılır. Ses kaydı saklanmaz.",
        "NSSpeechRecognitionUsageDescription": "Sesini yazıya çevirmek için konuşma tanıma kullanılır.",
        "NSCalendarsUsageDescription": "Faaliyetleri takvime eklemek için takvim izni istenir."
      }
    },
    "android": {
      "package": "com.tarimpusula.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#064D3B"
      },
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "CAMERA",
        "POST_NOTIFICATIONS",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "RECORD_AUDIO"
      ],
      "blockedPermissions": ["READ_CONTACTS", "READ_SMS"],
      "versionCode": 1
    },
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#064D3B"
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "eeedaf04-d003-4304-acbc-081656c29df5"
      }
    },
    "owner": "kumsal27s-team",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/eeedaf04-d003-4304-acbc-081656c29df5",
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 3000
    }
  }
}
