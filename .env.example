# Gizli anahtarlar yalnız .env'de tutulur. Anahtar yoksa sahte sağlayıcı kullanılır.
DATABASE_URL=postgres://tarim:tarim@localhost:5432/tarim
REDIS_URL=redis://localhost:6379
MQTT_URL=mqtt://localhost:1883
ANTHROPIC_API_KEY=
SMS_PROVIDER=fake
# netgsm: NETGSM_USER, NETGSM_PASSWORD, NETGSM_HEADER (onayli gonderici basligi)
NETGSM_USER=
NETGSM_PASSWORD=
NETGSM_HEADER=
# twilio: TWILIO_ACCOUNT_SID, TWILIO_AUTH_TOKEN, TWILIO_FROM (numara ya da MG... servis kimligi)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
# smsgate: SMS Gateway for Android (telefonun kendi hatti, ucretsiz): uygulamadaki Cloud kullanici/sifre
SMSGATE_USER=
SMSGATE_PASSWORD=
# Hava: openmeteo (varsayılan) ya da fake. Ticari kullanımda ücretli plan anahtarı gerekir (docs/RISKLER.md).
WEATHER_PROVIDER=openmeteo
OPEN_METEO_API_KEY=
# Bildirim: fake (varsayılan) ya da expo. Don taraması dakika aralığı (boşsa kapalı).
PUSH_PROVIDER=fake
EXPO_ACCESS_TOKEN=
FROST_SCAN_INTERVAL_MIN=
# Pusula AI: ANTHROPIC_API_KEY boşsa belirlenimci sahte sağlayıcı kullanılır. Model adı isteğe bağlı.
PUSULA_MODEL=
# Pazar fiyat toplayıcıları: adres boşsa o kaynak kapalıdır (uydurma adres yok). Aralık dakikadır, boşsa zamanlayıcı kapalı.
MARKET_COLLECT_INTERVAL_MIN=
MARKET_IBB_URL=
MARKET_TEPGE_URL=
MARKET_BORSA_URL=
MARKET_BORSA_NAME=
MARKET_BORSA_PROVINCE=
MARKET_BORSA_LAT=
MARKET_BORSA_LON=
# NDVI: Copernicus Data Space OAuth istemcisi. Boşsa "örnek veri" işaretli sahte sağlayıcı kullanılır.
COPERNICUS_CLIENT_ID=
COPERNICUS_CLIENT_SECRET=
SECRET_ENC_KEY=
# Mobil (apps/mobile): sunucu adresi. Telefonla denerken bilgisayarın YEREL AĞ adresi (Wi-Fi), localhost DEĞİL.
# `pnpm run demo -- --lan` çalışınca doğru adresi ekrana yazar. Boşsa uygulama "Sunucuya bağlanılamadı" kartı gösterir
# ve adres uygulama içinden (Ayarlar) yazılabilir.
EXPO_PUBLIC_API_URL=http://192.168.1.100:8210

# Nuvia (yapay zeka; yalniz sunucu). Sozlesme: docs/NUVIA_ENTEGRASYON.md
NUVIA_ADRES=
NUVIA_PROJE_ANAHTARI=
NUVIA_SAHTE=1
HABER_TARAMA=0
