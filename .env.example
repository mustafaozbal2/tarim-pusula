# Gizli anahtarlar yalnız .env'de tutulur. Anahtar yoksa sahte sağlayıcı kullanılır.
DATABASE_URL=postgres://tarim:tarim@localhost:5432/tarim
REDIS_URL=redis://localhost:6379
MQTT_URL=mqtt://localhost:1883
ANTHROPIC_API_KEY=
SMS_PROVIDER=fake
# Hava: openmeteo (varsayılan) ya da fake. Ticari kullanımda ücretli plan anahtarı gerekir (docs/RISKLER.md).
WEATHER_PROVIDER=openmeteo
OPEN_METEO_API_KEY=
# Bildirim: fake (varsayılan) ya da expo. Don taraması dakika aralığı (boşsa kapalı).
PUSH_PROVIDER=fake
EXPO_ACCESS_TOKEN=
FROST_SCAN_INTERVAL_MIN=
# Pusula AI: ANTHROPIC_API_KEY boşsa belirlenimci sahte sağlayıcı kullanılır. Model adı isteğe bağlı.
PUSULA_MODEL=
